story:
    As a command line user I want to show only selected nodes.

/name:
    summary: 'Choose nodes by name: '
    /whole:
        summary+: Complete identifier
        example: fmf ls --name /protocols/https
    /part:
        summary+: Identifier substring
        example: fmf ls --name protocols

/filter:
    summary: 'Choose nodes by attribute filter: '
    /simple:
        summary+: Single attribute
        example: fmf ls --filter component:wget
    /regexp:
        summary+: Regular expression
        example: fmf ls --filter component:python-.*
    /combination:
        summary+: Attribute combination
        example: fmf ls --filter 'component:wget & tier:1'

/condition:
    summary: 'Choose nodes by arbitrary condition'
    description: Any Python expression can be used.
    example: fmf ls --condition 'depth < 100'
