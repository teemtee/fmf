# Use the internal executor
execute:
    how: tmt

adjust:
  # Enable epel on CentOS Stream
  - prepare+:
      - name: enable-epel
        how: feature
        epel: enabled
        order: 10
    when: distro == centos-stream
  # Use the local provision method when running tests locally
  - provision:
        how: local
    when: initiator is not defined or initiator == human
